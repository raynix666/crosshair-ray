<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CrosshairApp.Overlay.OverlayWindow"
        xmlns:vm="using:CrosshairApp.ViewModels"
        xmlns:overlay="using:CrosshairApp.Overlay"
        x:DataType="vm:OverlayWindowViewModel"
        Width="300"
        Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None">
    <Grid Width="300" Height="300">
        <overlay:CrosshairDrawing Settings="{Binding CrosshairSettings}" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
