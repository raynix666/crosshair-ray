<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CrosshairApp.Controls">
    <!-- Global styles for rounded corners -->
    <Style Selector="Button, TextBox, ComboBox, ListBox, Slider, ToggleSwitch, CheckBox, controls|ColorPickerButton">
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
</Styles>
